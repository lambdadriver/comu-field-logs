# Signing material. Do not commit keystores, private keys, or certificates.
*.jks
*.keystore
*.bks
*.pk8
*.key
*.p12
*.pfx
*.pem
*.der
*.idsig
keystore/
keystores/
signing/

# Private working copies and secret files.
private/
.env
.env.*
*secret*
*password*
*credential*
secrets/

# Incident records and logs saved by the apps. Exports are user data.
incident-data/
saved-logs/
exports/
backups/
*.json
!tests/fixtures/tcard-sample.json
!experimental/tcard/tests/sample.json
experimental/tcard/tests/out/
*.csv
*.log

# Build output. The published APK in downloads/ is the only APK that belongs in git.
/build/
/dist/
*.apk
!downloads/COMU_Field_Logs_v1.1-public.apk
tests/out/

# OS and editor junk.
.DS_Store
Thumbs.db
*.swp
